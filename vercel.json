{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "realadbook.com",
    "www.realadbook.com"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.realadbook.com"
        }
      ],
      "destination": "https://realadbook.com/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/download-case.js": {
      "includeFiles": "api/_private/marbella-teardown.pdf"
    },
    "api/download-playbook.js": {
      "includeFiles": "api/_private/real-estate-meta-playbook.pdf"
    }
  }
}
